<launch>
  <!-- Start the UR5e stack first (separate terminals):
         roslaunch ur_robot_driver ur5e_bringup.launch robot_ip:=<ROBOT_IP>
         roslaunch ur5e_moveit_config moveit_planning_execution.launch
       or, without the robot:
         roslaunch ur5e_moveit_config demo.launch -->
  <arg name="config" default="$(find hri_legible_motion)/config/experiment.yaml"/>
  <arg name="participant" default="P00"/>
  <arg name="joy_dev" default="/dev/input/js0"/>

  <node pkg="joy" type="joy_node" name="joy_node">
    <param name="dev" value="$(arg joy_dev)"/>
    <param name="autorepeat_rate" value="0"/>
  </node>

  <node pkg="hri_legible_motion" type="motion_node.py" name="motion_node" output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node pkg="hri_legible_motion" type="experiment_node.py" name="experiment_node" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="participant_id" value="$(arg participant)"/>
  </node>
</launch>
